# Enquiry form email (api/enquiry.js). Copy this file to .env for local development
# (`npm run dev` reads it; restart after changes), and set the same variables in Vercel:
# Project > Settings > Environment Variables.
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Sender. Resend's test sender works without a verified domain (it can only deliver to the
# Resend account's own email); after verifying your domain, use an address on it instead.
ENQUIRY_FROM_EMAIL=Techademy <onboarding@resend.dev>
# Where enquiries are delivered; separate several addresses with commas
ENQUIRY_TO_EMAIL=harishsivakumarj@gmail.com
